{
 "name": "Ask the model shelf",
 "nodes": [
  {
   "name": "Booking form",
   "type": "n8n-nodes-base.formTrigger",
   "typeVersion": 2.2,
   "position": [
    0,
    0
   ],
   "parameters": {
    "formTitle": "Will this booking be cancelled?",
    "formDescription": "The model on the shelf gives the probability.",
    "formFields": {
     "values": [
      {
       "fieldLabel": "lead_time",
       "fieldType": "number",
       "requiredField": true
      },
      {
       "fieldLabel": "adr",
       "fieldType": "number",
       "requiredField": true
      },
      {
       "fieldLabel": "total_nights",
